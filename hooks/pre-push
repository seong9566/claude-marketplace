#!/bin/sh
# 플러그인 파일을 고쳤는데 version을 안 올린 푸시를 막는다.
#
# 왜: Claude Code는 이 clone이 아니라 plugins/cache/<플러그인>/<버전>/ 스냅샷을
# 읽고, 그 스냅샷은 plugin.json의 version이 바뀔 때만 새로 만들어진다. version을
# 그대로 두고 스킬만 고치면 갱신이 조용히 건너뛰어진다 — `claude plugin update`가
# "already at the latest version"이라고 답해서 실패가 성공처럼 보인다.
# 이 함정이 두 번 반복됐다: dev-harness(2fc1600) · obsidian-pm(e4d07ab, 7/30 커밋
# 3건이 3일 넘게 미반영).
#
# 설치: ln -s ../../hooks/pre-push .git/hooks/pre-push
# (전역 ~/.config/git/hooks/pre-push 브리지가 repo 로컬 훅을 대신 실행해준다)
#
# 우회가 필요하면: git push --no-verify

is_zero() { case "$1" in *[!0]*) return 1;; *) return 0;; esac; }

ver_at() {
  git show "$1:$2" 2>/dev/null |
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  is_zero "$local_sha" && continue          # 브랜치 삭제 — 검사할 것 없음

  if is_zero "$remote_sha"; then
    base=$(git rev-parse --verify --quiet origin/main) || continue   # 새 브랜치, 기준 없으면 생략
  else
    base=$remote_sha
  fi
  git cat-file -e "${base}^{commit}" 2>/dev/null || continue         # 강제푸시 등으로 기준이 없는 경우

  plugins=$(git ls-tree -r --name-only "$local_sha" |
    sed -n 's#^\([^/]*\)/\.claude-plugin/plugin\.json$#\1#p')

  for p in $plugins; do
    [ -n "$(git diff --name-only "$base" "$local_sha" -- "$p/")" ] || continue

    manifest="$p/.claude-plugin/plugin.json"
    old_ver=$(ver_at "$base" "$manifest")
    new_ver=$(ver_at "$local_sha" "$manifest")

    [ -n "$old_ver" ] || continue                  # 새로 추가된 플러그인
    [ "$old_ver" = "$new_ver" ] || continue        # version이 올랐다

    if [ "$fail" -eq 0 ]; then
      echo "pre-push: 플러그인 파일이 바뀌었는데 version이 그대로다 — 푸시를 막는다." >&2
      echo >&2
      fail=1
    fi
    echo "  $p — version $old_ver 유지, 바뀐 파일:" >&2
    git diff --name-only "$base" "$local_sha" -- "$p/" | sed 's/^/      /' >&2
  done
done

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "  version을 올려야 캐시 스냅샷이 새로 만들어진다. 같은 커밋에서 올린다:" >&2
  echo "      <플러그인>/.claude-plugin/plugin.json 의 \"version\"" >&2
  echo "      git commit --amend  (또는 새 커밋)" >&2
  echo >&2
  echo "  의도한 것이면: git push --no-verify" >&2
  exit 1
fi

exit 0
